# =================================================================
# KMAP COMPUTERS (.env.example)
# Environment Variables required when deploying to Hostinger / Vercel
# =================================================================

# 1. Hostinger Email SMTP (Required for Nodemailer OTP delivery)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@kmapcomputers.com
SMTP_PASS=onlyAdmin@2012

# 2. Vercel KV / Upstash Redis (Required for real-time cloud data sync)
# (Automatically created when you connect Upstash / Storage in Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
